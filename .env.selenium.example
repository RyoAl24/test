# ── Mercari ログイン ──────────────────────────────────────
MERCARI_EMAIL=your_mercari_email@example.com
MERCARI_PASSWORD=your_mercari_password

# ── Slack ─────────────────────────────────────────────────
# 取得方法: https://api.slack.com/apps → Bot Token Scopes: chat:write
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_CHANNEL_ID=C0XXXXXXXXXX

# ── ビジネスロジック ───────────────────────────────────────
MIN_PROFIT_RATE=0.20        # 最低利益率 (0.20 = 20%)
PRICE_MULTIPLIER_MIN=1.5    # Amazon 出品価格 = 楽天価格 × この範囲の中間値
PRICE_MULTIPLIER_MAX=2.0
MIN_SALES_COUNT=3           # 直近N日で最低この件数売れていること
DAYS_LOOKBACK=7             # 過去何日間を対象にするか

# ── Selenium ──────────────────────────────────────────────
HEADLESS=true               # false にするとブラウザを画面に表示（デバッグ用）
PAGE_LOAD_TIMEOUT=30
IMPLICIT_WAIT=10

# ── スケジュール ───────────────────────────────────────────
DAILY_RUN_TIME=06:00        # 毎日この時刻に自動実行
