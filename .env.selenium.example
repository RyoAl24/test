# ── Mercari ログイン ──────────────────────────────────────
MERCARI_EMAIL=your_email@example.com
MERCARI_PASSWORD=your_password

# ── 楽天ウェブサービス API ─────────────────────────────────
# 取得: https://webservice.rakuten.co.jp/
RAKUTEN_APP_ID=your_rakuten_app_id
RAKUTEN_AFFILIATE_ID=your_rakuten_affiliate_id

# ── Slack ─────────────────────────────────────────────────
# Bot Token: https://api.slack.com/apps → OAuth & Permissions → Bot Token Scopes: chat:write
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxx
# チャンネル名（sedori）またはチャンネルID（C0XXXXXXXXXX）どちらでも可
SLACK_CHANNEL=sedori

# ── 利益計算 ───────────────────────────────────────────────
# 利益 = 売価 - 売価×MERCARI_FEE_RATE - SHIPPING_FEE - 仕入れ価格
MERCARI_FEE_RATE=0.10   # Mercari 手数料 10%
SHIPPING_FEE=600        # 配送料（円）
MIN_PROFIT_RATE=0.20    # 最低利益率 (0.20 = 20%)

# ── フィルタ条件 ───────────────────────────────────────────
MIN_SALES_COUNT=3       # 直近N日で最低この件数売れていること
DAYS_LOOKBACK=7         # 過去何日間を対象にするか

# ── Selenium ──────────────────────────────────────────────
HEADLESS=true           # false にするとブラウザ表示（デバッグ用）
PAGE_LOAD_TIMEOUT=30
IMPLICIT_WAIT=10

# ── スケジュール（schedule モジュール使用時） ──────────────
DAILY_RUN_TIME=06:00
